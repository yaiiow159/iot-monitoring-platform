<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iotmon</groupId>
        <artifactId>iot-monitoring-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>iot-domain</artifactId>
    <name>iot-domain</name>
    <description>領域層：裝置、機櫃、機型、告警規則的業務模型與不變條件</description>

    <!--
        這個模組刻意「沒有」任何依賴。
        領域層一旦沾上 Spring、JPA 或 Kafka，業務規則就會開始配合框架的形狀變形，
        而框架換代時整層都要跟著改寫。ArchitectureTest 會擋下任何違規的 import。
    -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
